@page "/admin/saisons"
@layout AdminLayout
@inherits ApiPage

<PageTitle>Saisons – Administration</PageTitle>

<PageHeader Title="Saisons" Subtitle="Spielzeiten, denen Meisterschaften zugeordnet werden">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditAsync(null))">Neue Saison</MudButton>
    </Actions>
</PageHeader>

<LoadingState Loading="Loading" Error="@Error" IsEmpty="_seasons.Count == 0" EmptyText="Noch keine Saison – lege die erste an.">
    <MudTable T="SeasonDto" Items="_seasons" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="rounded-lg">
        <HeaderContent>
            <MudTh>Bezeichnung</MudTh>
            <MudTh>Start</MudTh>
            <MudTh>Ende</MudTh>
            <MudTh Class="text-right">Meisterschaften</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="font-weight-medium">@context.Name</MudTd>
            <MudTd>@context.StartDate.ToString("dd.MM.yyyy")</MudTd>
            <MudTd>@context.EndDate.ToString("dd.MM.yyyy")</MudTd>
            <MudTd Class="text-right">@context.ChampionshipCount</MudTd>
            <MudTd Class="text-right">
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" Disabled="@(context.ChampionshipCount > 0)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</LoadingState>

@inherits FormDialog

<DialogFrame Error="@Error" Busy="Busy" CanSave="@(IsValid && _start is not null && _end is not null)" OnSave="SaveAsync" OnCancel="Cancel">
    <MudForm @ref="Form" @bind-IsValid="IsValid">
        <MudTextField @bind-Value="_name" Label="Bezeichnung" Placeholder="z.B. 2026/27" Required="true" Variant="Variant.Outlined" Class="mb-3" />
        <MudGrid Spacing="2">
            <MudItem xs="6"><MudDatePicker @bind-Date="_start" Label="Saisonstart" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6"><MudDatePicker @bind-Date="_end" Label="Saisonende" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
    </MudForm>
</DialogFrame>

@page "/admin/klubs"
@layout AdminLayout
@inherits ApiPage

<PageTitle>Klubs – Administration</PageTitle>

<PageHeader Title="Klubs" Subtitle="Vereine und Kegelklubs verwalten">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditAsync(null))">Neuer Klub</MudButton>
    </Actions>
</PageHeader>

<LoadingState Loading="Loading" Error="@Error" IsEmpty="_clubs.Count == 0" EmptyText="Noch keine Klubs – lege den ersten an.">
    <MudTable T="ClubDto" Items="_clubs" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="rounded-lg">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Kürzel</MudTh>
            <MudTh>Ort</MudTh>
            <MudTh Class="text-right">Aktive Kegler</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="font-weight-medium">@context.Name</MudTd>
            <MudTd>@context.ShortName</MudTd>
            <MudTd>@(context.City ?? "–")</MudTd>
            <MudTd Class="text-right">@context.PlayerCount</MudTd>
            <MudTd Class="text-right">
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" Disabled="@(context.PlayerCount > 0)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</LoadingState>

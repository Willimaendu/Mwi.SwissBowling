@page "/klubs"
@inherits ApiPage

<PageTitle>Klubs – SFKV</PageTitle>

<PageHeader Title="Klubs" Subtitle="Alle Kegelklubs nach Unterverband" />

<LoadingState Loading="Loading" Error="@Error" IsEmpty="_clubs.Count == 0" EmptyText="Noch keine Klubs erfasst." Columns="6">
    <MudTable T="ClubDto" Items="_clubs" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="rounded-lg" Filter="Matches" GroupBy="_groupByAssociation"
              RowClass="cursor-pointer" OnRowClick="@(args => Navigation.NavigateTo($"/kegler?club={args.Item!.Id}"))">
        <ToolBarContent>
            <MudTextField @bind-Value="_search" Placeholder="Klub oder Ort suchen" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" DebounceInterval="300" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 320px;" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Klub</MudTh>
            <MudTh>Ort</MudTh>
            <MudTh>Kat.</MudTh>
            <MudTh>Heimbahn</MudTh>
            <MudTh Class="text-right">Aktive Kegler</MudTh>
        </HeaderContent>
        <GroupHeaderTemplate>
            <MudTh colspan="5" Class="font-weight-bold">@context.Key</MudTh>
        </GroupHeaderTemplate>
        <RowTemplate>
            <MudTd Class="font-weight-medium">@context.Name</MudTd>
            <MudTd>@(context.City ?? "–")</MudTd>
            <MudTd>@context.Category</MudTd>
            <MudTd>@(context.HomeVenue ?? "–")</MudTd>
            <MudTd Class="text-right">@context.PlayerCount</MudTd>
        </RowTemplate>
    </MudTable>
</LoadingState>

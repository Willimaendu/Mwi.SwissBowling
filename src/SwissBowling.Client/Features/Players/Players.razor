@page "/kegler"
@inherits ApiPage

<PageTitle>Kegler – Swiss Bowling</PageTitle>

<PageHeader Title="Keglerinnen & Kegler" Subtitle="Alle aktiven Mitglieder mit Klub und Kategorie" />

<LoadingState Loading="Loading" Error="@Error" IsEmpty="_players.Count == 0" EmptyText="Noch keine Kegler erfasst.">
    <MudTable T="PlayerDto" Items="_players" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="rounded-lg" Filter="Matches"
              RowClass="cursor-pointer" OnRowClick="@(args => Navigation.NavigateTo($"/kegler/{args.Item!.Id}"))" Breakpoint="Breakpoint.None"
              Virtualize="true" FixedHeader="true" Height="@AppTheme.TableHeight">
        <ToolBarContent>
            <MudTextField @bind-Value="_search" Placeholder="Name oder Lizenz" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <MudAutocomplete T="ClubDto" @bind-Value="_club" SearchFunc="SearchClubsAsync" ToStringFunc="@(c => c?.Name ?? string.Empty)" Label="Klub"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" ResetValueOnEmptyText="true" CoerceText="true" MaxItems="30"
                             Style="width: 280px;">
                <ItemTemplate Context="club">
                    @club.Name <span class="mud-text-secondary ml-1">@club.City</span>
                </ItemTemplate>
            </MudAutocomplete>
            <MudSelect T="PlayerCategory?" @bind-Value="_category" Label="Kategorie" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="width: 180px;">
                @foreach (var category in Enum.GetValues<PlayerCategory>())
                {
                    <MudSelectItem T="PlayerCategory?" Value="@category">@category.Label()</MudSelectItem>
                }
            </MudSelect>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<PlayerDto, object>(p => p.Name)" InitialDirection="SortDirection.Ascending">Name</MudTableSortLabel></MudTh>
            <MudTh Class="d-none d-sm-table-cell">Ort</MudTh>
            <MudTh>Klub</MudTh>
            <MudTh Class="d-none d-md-table-cell">Unterverband</MudTh>
            <MudTh Class="d-none d-sm-table-cell">Kategorie</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="font-weight-medium">@context.Name</MudTd>
            <MudTd Class="d-none d-sm-table-cell">@context.City</MudTd>
            <MudTd>@(context.ClubName ?? "Einzelmitglied")</MudTd>
            <MudTd Class="d-none d-md-table-cell mud-text-secondary">@context.AssociationName</MudTd>
            <MudTd Class="d-none d-sm-table-cell">@context.Category.Label()</MudTd>
        </RowTemplate>
    </MudTable>
</LoadingState>

@page "/admin/kegler"
@layout AdminLayout
@inherits ApiPage

<PageTitle>Kegler – Administration</PageTitle>

<PageHeader Title="Kegler" Subtitle="Keglerinnen und Kegler verwalten">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditAsync(null))" Disabled="@(_associations.Count == 0)">Neuer Kegler</MudButton>
    </Actions>
</PageHeader>

@if (!Loading && _associations.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">Bitte zuerst einen <MudLink Href="/admin/unterverbaende">Unterverband</MudLink> anlegen.</MudAlert>
}

<LoadingState Loading="Loading" Error="@Error" Columns="7">
    <MudTable @ref="_table" T="PlayerDto" ServerData="LoadPageAsync" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="rounded-lg" RowsPerPage="50">
        <ToolBarContent>
            <MudTextField @bind-Value="_search" @bind-Value:after="ReloadAsync" Placeholder="Name, Ort oder Lizenz" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" DebounceInterval="300" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 320px;" />
            <MudSpacer />
            <MudSwitch T="bool" @bind-Value="_showInactive" @bind-Value:after="ReloadAsync" Label="Inaktive anzeigen" Color="Color.Primary" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Ort</MudTh>
            <MudTh>Klub</MudTh>
            <MudTh>Unterverband</MudTh>
            <MudTh>Kategorie</MudTh>
            <MudTh>Lizenz</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="@(context.IsActive ? "font-weight-medium" : "mud-text-secondary")">@context.Name @(context.IsActive ? "" : "(inaktiv)")</MudTd>
            <MudTd>@context.City</MudTd>
            <MudTd>@(context.ClubName ?? "Einzelmitglied")</MudTd>
            <MudTd>@context.AssociationName</MudTd>
            <MudTd>@context.Category.Label()</MudTd>
            <MudTd>@(context.LicenseNumber ?? "–")</MudTd>
            <MudTd Class="text-right">
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => EditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>
        <LoadingContent>
            <TableSkeleton Rows="10" Columns="6" />
        </LoadingContent>
        <NoRecordsContent>
            <MudText Class="pa-6 mud-text-secondary">Keine Kegler gefunden.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Pro Seite" InfoFormat="{first_item}–{last_item} von {all_items}" PageSizeOptions="@([25, 50, 100])" />
        </PagerContent>
    </MudTable>
</LoadingState>

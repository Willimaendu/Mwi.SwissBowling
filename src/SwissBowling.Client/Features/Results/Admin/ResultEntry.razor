@page "/admin/meisterschaften/{Id:guid}/erfassung"
@layout AdminLayout
@inherits ApiPage

<PageTitle>Resultaterfassung – Administration</PageTitle>

<div class="result-entry">
<LoadingState Loading="Loading" Error="@Error">
    @if (_championship is { } championship)
    {
        <PageHeader Title="@($"{championship.Name} – Resultaterfassung")"
                    Subtitle="@($"{championship.StartDate:dd.MM.yyyy} – {championship.EndDate:dd.MM.yyyy} · {championship.Throws} Wurf · max. {championship.MaxPins} Holz")"
                    Breadcrumbs="@([new("Meisterschaften", "/admin/meisterschaften"), new(championship.Name, $"/admin/meisterschaften/{Id}"), new("Erfassung", null, disabled: true)])">
            <Actions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveAsync" Disabled="@(DirtyCount == 0)">
                    Speichern @(DirtyCount > 0 ? $"({DirtyCount})" : "")
                </MudButton>
            </Actions>
        </PageHeader>

        <MudTable T="Row" Items="_rows" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="rounded-lg" Filter="Matches" FixedHeader="true" Height="calc(100vh - 300px)"
                  RowClassFunc="@((row, _) => row.IsDirty ? "dirty" : string.Empty)">
            <ToolBarContent>
                <MudTextField @bind-Value="_search" Placeholder="Kegler oder Klub filtern" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-0" Style="max-width: 320px;" />
                <MudSpacer />
                <MudSwitch T="bool" @bind-Value="_onlyWithResult" Label="Nur mit Resultat" Color="Color.Primary" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Kegler</MudTh>
                <MudTh>Klub</MudTh>
                <MudTh>Kat.</MudTh>
                <MudTh Style="width: 140px;">Holz</MudTh>
                <MudTh Style="width: 120px;">Neuner</MudTh>
                <MudTh Style="width: 100px;">Ausz.</MudTh>
                <MudTh Style="width: 180px;">Datum</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Class="font-weight-medium">@context.Player.Name</MudTd>
                <MudTd>@context.Player.ClubName</MudTd>
                <MudTd>@context.Player.Category</MudTd>
                <MudTd><MudNumericField T="int?" @bind-Value="context.Pins" Min="0" Max="championship.MaxPins" HideSpinButtons="true" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="–" Class="pins" /></MudTd>
                <MudTd><MudNumericField T="int" @bind-Value="context.Nines" Min="0" Max="championship.Throws" HideSpinButtons="true" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pins" /></MudTd>
                <MudTd><MudCheckBox T="bool" @bind-Value="context.Award" Color="Color.Warning" /></MudTd>
                <MudTd><MudDatePicker @bind-Date="context.Date" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
            </RowTemplate>
        </MudTable>
    }
</LoadingState>
</div>

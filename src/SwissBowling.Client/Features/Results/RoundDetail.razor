@page "/runden/{Id:guid}"
@inherits ApiPage

<PageTitle>@(_detail is { } d ? $"{d.Championship.Name} – Runde {d.Round.Number}" : "Runde") – Swiss Bowling</PageTitle>

<LoadingState Loading="Loading" Error="@Error">
    @if (_detail is { } detail)
    {
        <PageHeader Title="@($"Runde {detail.Round.Number}")" Subtitle="@($"{detail.Round.Date:dd.MM.yyyy} · {detail.Round.Venue}")"
                    Breadcrumbs="@([new("Meisterschaften", "/meisterschaften"), new(detail.Championship.Name, $"/meisterschaften/{detail.Championship.Id}"), new($"Runde {detail.Round.Number}", null, disabled: true)])" />

        <MudTable T="ResultDto" Items="detail.Results" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="rounded-lg"
                  RowClass="cursor-pointer" OnRowClick="@(args => Navigation.NavigateTo($"/kegler/{args.Item!.PlayerId}"))" Breakpoint="Breakpoint.None">
            <HeaderContent>
                <MudTh Style="width: 64px;">Rang</MudTh>
                <MudTh>Kegler</MudTh>
                <MudTh Class="d-none d-sm-table-cell">Klub</MudTh>
                <MudTh Class="d-none d-md-table-cell">Kategorie</MudTh>
                <MudTh Class="text-right">Holz</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><RankBadge Rank="RankOf(context)" /></MudTd>
                <MudTd Class="font-weight-medium">@context.PlayerName</MudTd>
                <MudTd Class="d-none d-sm-table-cell">@context.ClubShortName</MudTd>
                <MudTd Class="d-none d-md-table-cell">@context.Category.Label()</MudTd>
                <MudTd Class="text-right font-weight-bold">@context.Pins</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-6 mud-text-secondary">Für diese Runde liegen noch keine Resultate vor.</MudText>
            </NoRecordsContent>
        </MudTable>
    }
</LoadingState>

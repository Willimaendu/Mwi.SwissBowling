@page "/admin/import"
@layout AdminLayout
@inherits ApiPage

<PageTitle>Import – Administration</PageTitle>

<PageHeader Title="Import / Aktualisierung" Subtitle="Stammdaten von www.sfkv.ch, Resultate (Meisterschaft und MS Damen) von www.uvweb.kegler.ch">
    <Actions>
        <MudCheckBox T="bool" @bind-Value="_includeArchive" Label="Archiv (PDF) einschliessen" Color="Color.Primary" Disabled="@IsRunning" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.CloudDownload" OnClick="StartAsync" Disabled="@IsRunning">
            @if (IsRunning)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Import starten
        </MudButton>
    </Actions>
</PageHeader>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    Ein Lauf übernimmt der Reihe nach alle Unterverbände (Vorstand, Mitglieder, Klubs, Kegelbahnen), alle aktuell publizierten Ranglisten und –
    falls gewählt – die noch nicht importierten Archiv-Ranglisten aller Unterverbände. Alles ist idempotent; der Lauf läuft im Hintergrund weiter,
    auch wenn diese Seite verlassen wird. Stammdaten und aktuelle Ranglisten werden zusätzlich automatisch abgeglichen (<code>Import:SyncIntervalHours</code>).
</MudAlert>

@if (_startError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_startError</MudAlert>
}

<LoadingState Loading="Loading" Error="@Error" IsEmpty="_runs.Count == 0" EmptyText="Noch kein Importlauf.">
    <MudExpansionPanels MultiExpansion="false" Elevation="0" Outlined="true" Class="rounded-lg">
        @foreach (var run in _runs)
        {
            <MudExpansionPanel Expanded="@(run.Id == _runs[0].Id)">
                <TitleContent>
                    <div class="d-flex align-center gap-3 flex-wrap">
                        <ImportStatus Status="run.Status" />
                        <MudText Typo="Typo.body1" Class="font-weight-medium">@run.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @(run.IncludeArchive ? "mit Archiv" : "ohne Archiv") · @run.Clubs Klubs · @run.Players Kegler · @run.Results Resultate
                            @if (run.Errors > 0)
                            {
                                <span class="mud-error-text"> · @run.Errors Fehler</span>
                            }
                        </MudText>
                        @if (run.CurrentStep is { } step)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">@step …</MudChip>
                        }
                        @if (run.FinishedAt is { } finished)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Dauer @((finished - run.StartedAt).ToString(@"hh\:mm\:ss"))</MudText>
                        }
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudTable T="ImportLogEntryDto" Items="run.Entries.OrderByDescending(e => e.Time)" Dense="true" Hover="true" Elevation="0" FixedHeader="true" Height="400px"
                              RowClassFunc="@((e, _) => e.IsError ? "mud-error-text" : string.Empty)">
                        <HeaderContent>
                            <MudTh Style="width: 90px;">Zeit</MudTh>
                            <MudTh>Quelle</MudTh>
                            <MudTh Class="text-right">Klubs</MudTh>
                            <MudTh Class="text-right">Kegler</MudTh>
                            <MudTh Class="text-right">Resultate</MudTh>
                            <MudTh>Meldung</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Class="mud-text-secondary">@context.Time.ToLocalTime().ToString("HH:mm:ss")</MudTd>
                            <MudTd>@context.Source</MudTd>
                            <MudTd Class="text-right">@(context.Clubs > 0 ? context.Clubs : "")</MudTd>
                            <MudTd Class="text-right">@(context.Players > 0 ? context.Players : "")</MudTd>
                            <MudTd Class="text-right">@(context.Results > 0 ? context.Results : "")</MudTd>
                            <MudTd>@context.Message</MudTd>
                        </RowTemplate>
                    </MudTable>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
</LoadingState>

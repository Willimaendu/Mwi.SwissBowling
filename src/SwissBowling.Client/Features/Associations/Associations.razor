@page "/unterverbaende"
@inherits ApiPage

<PageTitle>Unterverbände – Swiss Bowling</PageTitle>

<PageHeader Title="Unterverbände" Subtitle="Die regionalen Unterverbände der SFKV mit Klubs, Mitgliedern und Kegelbahnen" />

<LoadingState Loading="Loading" Error="@Error" IsEmpty="_items.Count == 0" EmptyText="Noch keine Unterverbände erfasst.">
    <MudGrid Spacing="3">
        @foreach (var association in _items)
        {
            <MudItem xs="12" sm="6" lg="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-lg cursor-pointer" @onclick="@(() => Navigation.NavigateTo($"/unterverbaende/{association.Id}"))">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@association.Name</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@association.ClubCount Klubs · @association.PlayerCount Mitglieder</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</LoadingState>

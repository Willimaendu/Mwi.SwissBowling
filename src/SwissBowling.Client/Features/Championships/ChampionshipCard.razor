<div class="card-wrap">
<MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-lg card" @onclick="@(() => Navigation.NavigateTo($"/meisterschaften/{Championship.Id}"))">
    <div class="d-flex justify-space-between align-start gap-3 flex-wrap">
        <div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@Championship.Name</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StatusColor">@Status.Label()</MudChip>
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @Championship.AssociationName · @Championship.StartDate.ToString("dd.MM.") – @Championship.EndDate.ToString("dd.MM.yyyy") · @Championship.Throws Wurf
            </MudText>
            @if (Championship.Venue is not null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Championship.Venue@(Championship.City is null ? "" : $", {Championship.City}")</MudText>
            }
        </div>
        <div class="text-right">
            <MudText Typo="Typo.h6" Class="font-weight-bold">@Championship.ResultCount</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Resultate</MudText>
        </div>
    </div>
</MudPaper>
</div>

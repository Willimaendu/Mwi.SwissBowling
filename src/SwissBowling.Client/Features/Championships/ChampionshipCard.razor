<div class="card-wrap">
<MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-lg card" @onclick="@(() => Navigation.NavigateTo($"/meisterschaften/{Championship.Id}"))">
    <div class="d-flex justify-space-between align-start gap-3 flex-wrap">
        <div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@Championship.Name</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StatusColor">@Championship.Status.Label()</MudChip>
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Saison @Championship.SeasonName · @Championship.ThrowsPerRound Wurf · beste @Championship.CountedRounds von @Championship.NumberOfRounds Runden
            </MudText>
        </div>
        <div class="text-right">
            <MudText Typo="Typo.h6" Class="font-weight-bold">@Championship.ParticipantCount</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Teilnehmende</MudText>
        </div>
    </div>
    <MudProgressLinear Color="Color.Primary" Rounded="true" Size="Size.Small" Class="mt-3" Value="@(100.0 * Championship.RoundsCompleted / Championship.NumberOfRounds)" />
</MudPaper>
</div>

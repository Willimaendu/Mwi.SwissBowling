@page "/meisterschaften/{Id:guid}"
@inherits ApiPage

<PageTitle>@(_detail?.Championship.Name ?? "Meisterschaft") – SFKV</PageTitle>

<LoadingState Loading="Loading" Error="@Error">
    <LoadingContent><DetailSkeleton WithTabs="true" TableColumns="6" /></LoadingContent>
    <ChildContent>
    @if (_detail is { } detail)
    {
        <PageHeader Title="@detail.Championship.Name"
                    Subtitle="@($"{detail.Championship.AssociationName} · {detail.Championship.StartDate:dd.MM.yyyy} – {detail.Championship.EndDate:dd.MM.yyyy} · {detail.Championship.Throws} Wurf")"
                    Breadcrumbs="@([new("Meisterschaften", "/meisterschaften"), new(detail.Championship.Name, null, disabled: true)])" />

        <MudGrid Spacing="3" Class="mb-6">
            <MudItem xs="6" md="3"><StatCard Label="Durchführer" Value="@(detail.Championship.Organizer ?? "–")" /></MudItem>
            <MudItem xs="6" md="3"><StatCard Label="Lokal" Value="@(detail.Championship.Venue ?? "–")" /></MudItem>
            <MudItem xs="6" md="3"><StatCard Label="Teilnehmende" Value="@detail.Ranking.Count.ToString()" /></MudItem>
            <MudItem xs="6" md="3"><StatCard Label="Höchstresultat" Value="@(detail.Ranking.Count == 0 ? "–" : detail.Ranking.Max(r => r.Pins).ToString())" /></MudItem>
        </MudGrid>

        @if (detail.Ranking.Count == 0)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-10 text-center rounded-lg mud-text-secondary">Noch keine Resultate erfasst.</MudPaper>
        }
        else
        {
            <RankingTabs Ranking="detail.Ranking" HighlightPlayerId="HighlightPlayerId" />
        }
    }
    </ChildContent>
</LoadingState>

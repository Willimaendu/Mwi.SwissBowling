@page "/meisterschaften"
@inherits ApiPage

<PageTitle>Meisterschaften – Swiss Bowling</PageTitle>

<PageHeader Title="Meisterschaften" Subtitle="Alle Einzelmeisterschaften nach Saison">
    <Actions>
        <MudSelect T="Guid?" Value="_seasonId" ValueChanged="OnSeasonChanged" Label="Saison" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width: 200px;">
            @foreach (var season in _seasons)
            {
                <MudSelectItem T="Guid?" Value="@season.Id">@season.Name</MudSelectItem>
            }
        </MudSelect>
    </Actions>
</PageHeader>

<LoadingState Loading="Loading" Error="@Error" IsEmpty="_championships.Count == 0" EmptyText="Keine Meisterschaften gefunden.">
    <MudGrid Spacing="3">
        @foreach (var championship in _championships)
        {
            <MudItem xs="12" md="6"><ChampionshipCard Championship="championship" /></MudItem>
        }
    </MudGrid>
</LoadingState>

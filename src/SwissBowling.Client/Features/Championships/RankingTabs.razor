@* Rangliste nach Disziplin (Meisterschaft, MS Damen) und darin nach Kategorie *@
<div class="ranking-tabs">
    <MudTabs Elevation="0" Rounded="true" Outlined="true" ApplyEffectsToContainer="true" PanelClass="pt-4" Class="rounded-lg" ActivePanelIndex="_disciplineIndex">
        @foreach (var discipline in Disciplines)
        {
            <MudTabPanel Text="@($"{discipline.Key.Label()} ({discipline.Count()})")">
                <MudTabs Elevation="0" Rounded="true" PanelClass="pt-4" MinimumTabWidth="90px" ActivePanelIndex="@(discipline.Key == _highlight?.Discipline ? _categoryIndex : 0)">
                    @foreach (var category in Categories(discipline))
                    {
                        <MudTabPanel Text="@($"{category.Key.Label()} ({category.Count()})")">
                            <RankingTable Entries="category.ToList()" HighlightPlayerId="HighlightPlayerId" />
                        </MudTabPanel>
                    }
                </MudTabs>
            </MudTabPanel>
        }
    </MudTabs>
</div>

<div class="ranking">
<MudTable T="RankingEntryDto" Items="Entries" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="rounded-lg"
          RowClass="cursor-pointer" RowClassFunc="RowClass" OnRowClick="OnRowClick" Breakpoint="Breakpoint.None" Filter="Matches">
    <ToolBarContent>
        <MudSpacer />
        <MudTextField @bind-Value="_search" Placeholder="Kegler oder Klub suchen" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-0" Style="max-width: 320px;" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh Style="width: 64px;">Rang</MudTh>
        <MudTh>Kegler</MudTh>
        <MudTh Class="d-none d-sm-table-cell">Klub</MudTh>
        <MudTh Class="text-right">Holz</MudTh>
        <MudTh Class="text-right d-none d-sm-table-cell">Neuner</MudTh>
        <MudTh Class="d-none d-md-table-cell">Auszeichnung</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><RankBadge Rank="context.Rank" /></MudTd>
        <MudTd Class="font-weight-medium">@context.PlayerName</MudTd>
        <MudTd Class="d-none d-sm-table-cell">@context.ClubName</MudTd>
        <MudTd Class="text-right font-weight-bold">@context.Pins</MudTd>
        <MudTd Class="text-right d-none d-sm-table-cell">@context.Nines</MudTd>
        <MudTd Class="d-none d-md-table-cell">
            @if (context.Award)
            {
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Size="Size.Small" />
            }
        </MudTd>
    </RowTemplate>
</MudTable>
</div>

@inherits FormDialog

<DialogFrame Error="@Error" Busy="Busy" CanSave="@(IsValid && _model.AssociationId != Guid.Empty && _model.Start is not null && _model.End is not null)" OnSave="SaveAsync" OnCancel="Cancel">
    <MudForm @ref="Form" @bind-IsValid="IsValid">
        <MudGrid Spacing="2">
            <MudItem xs="12"><MudTextField @bind-Value="_model.Name" Label="Bezeichnung" Required="true" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12">
                <MudSelect @bind-Value="_model.AssociationId" Label="Unterverband" Variant="Variant.Outlined">
                    @foreach (var association in Associations)
                    {
                        <MudSelectItem Value="@association.Id">@association.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6"><MudDatePicker @bind-Date="_model.Start" Label="Beginn" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="6"><MudDatePicker @bind-Date="_model.End" Label="Ende" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="4"><MudNumericField @bind-Value="_model.Throws" Label="Anzahl Würfe" Min="1" Max="1000" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="8"><MudTextField @bind-Value="_model.Organizer" Label="Durchführer (Klub)" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="8"><MudTextField @bind-Value="_model.Venue" Label="Lokal / Kegelbahn" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="4"><MudTextField @bind-Value="_model.City" Label="Ort" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
    </MudForm>
</DialogFrame>

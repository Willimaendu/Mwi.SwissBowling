@page "/admin"
@page "/admin/meisterschaften"
@layout AdminLayout
@inherits ApiPage

<PageTitle>Meisterschaften – Administration</PageTitle>

<PageHeader Title="Meisterschaften" Subtitle="Meisterschaften planen, Runden verwalten, Resultate erfassen">
    <Actions>
        <AuthorizeView Roles="@Roles.Admin">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync" Disabled="@(_seasons.Count == 0)">Neue Meisterschaft</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (!Loading && _seasons.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">Bitte zuerst eine <MudLink Href="/admin/saisons">Saison</MudLink> anlegen.</MudAlert>
}

<LoadingState Loading="Loading" Error="@Error" IsEmpty="_championships.Count == 0" EmptyText="Noch keine Meisterschaften.">
    <MudTable T="ChampionshipDto" Items="_championships" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="rounded-lg"
              RowClass="cursor-pointer" OnRowClick="@(args => Navigation.NavigateTo($"/admin/meisterschaften/{args.Item!.Id}"))">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Saison</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Runden</MudTh>
            <MudTh Class="text-right">Teilnehmende</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="font-weight-medium">@context.Name</MudTd>
            <MudTd>@context.SeasonName</MudTd>
            <MudTd>@context.Status.Label()</MudTd>
            <MudTd>@context.RoundsCompleted / @context.NumberOfRounds abgeschlossen</MudTd>
            <MudTd Class="text-right">@context.ParticipantCount</MudTd>
        </RowTemplate>
    </MudTable>
</LoadingState>

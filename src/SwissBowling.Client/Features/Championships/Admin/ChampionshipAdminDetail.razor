@page "/admin/meisterschaften/{Id:guid}"
@layout AdminLayout
@inherits ApiPage

<PageTitle>@(_detail?.Championship.Name ?? "Meisterschaft") – Administration</PageTitle>

<LoadingState Loading="Loading" Error="@Error">
    <LoadingContent><DetailSkeleton WithStats="false" WithTabs="true" TableColumns="6" /></LoadingContent>
    <ChildContent>
    @if (_detail is { } detail)
    {
        <PageHeader Title="@detail.Championship.Name"
                    Subtitle="@($"{detail.Championship.AssociationName} · {detail.Championship.StartDate:dd.MM.yyyy} – {detail.Championship.EndDate:dd.MM.yyyy} · {detail.Championship.Throws} Wurf · {detail.Championship.Venue}")"
                    Breadcrumbs="@([new("Meisterschaften", "/admin/meisterschaften"), new(detail.Championship.Name, null, disabled: true)])">
            <Actions>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.OpenInNew" Href="@($"/meisterschaften/{Id}")" Target="_blank">Öffentliche Ansicht</MudButton>
                <AuthorizeView Roles="@Roles.Admin">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit" OnClick="EditAsync">Bearbeiten</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync" Disabled="@(detail.Ranking.Count > 0)">Löschen</MudButton>
                </AuthorizeView>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.EditNote" Href="@($"/admin/meisterschaften/{Id}/erfassung")">Resultate erfassen</MudButton>
            </Actions>
        </PageHeader>

        @if (detail.Championship.ExternalId is { } externalId)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                Importiert von UVweb (MS-Nr. @externalId). Ein erneuter Import aktualisiert die Resultate.
            </MudAlert>
        }

        @if (detail.Ranking.Count == 0)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-10 text-center rounded-lg mud-text-secondary">Noch keine Resultate erfasst.</MudPaper>
        }
        else
        {
            <RankingTabs Ranking="detail.Ranking" />
        }
    }
    </ChildContent>
</LoadingState>

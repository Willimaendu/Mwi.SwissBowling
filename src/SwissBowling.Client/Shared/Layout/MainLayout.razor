@inherits LayoutComponentBase

<MudThemeProvider Theme="AppTheme.Theme" @bind-IsDarkMode="_darkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" BackdropClick="false" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="border-b mud-border-lines-default">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="d-md-none" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudLink Href="/" Underline="Underline.None" Class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.SportsScore" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">Swiss Bowling</MudText>
        </MudLink>
        <MudSpacer />
        <nav class="d-none d-md-flex gap-1">
            @foreach (var (href, text) in Links)
            {
                <MudButton Href="@href" Color="Color.Inherit">@text</MudButton>
            }
        </nav>
        <MudSpacer />
        <MudIconButton Icon="@(_darkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Color="Color.Inherit" OnClick="@(() => _darkMode = !_darkMode)" />
        <MudButton Href="/admin" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AdminPanelSettings" Class="ml-2">Administration</MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary" Class="d-md-none">
        <MudNavMenu Class="pa-2">
            @foreach (var (href, text) in Links)
            {
                <MudNavLink Href="@href" Match="@(href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">@text</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

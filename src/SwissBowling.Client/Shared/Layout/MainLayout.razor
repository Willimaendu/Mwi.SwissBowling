@inherits LayoutComponentBase

<MudThemeProvider Theme="AppTheme.Theme" @bind-IsDarkMode="_darkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" BackdropClick="false" />
<MudSnackbarProvider />

<div class="site">
<MudLayout>
    <MudAppBar Elevation="0" Class="appbar">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="d-flex align-center px-0">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" Class="d-md-none" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            <MudLink Href="/" Underline="Underline.None" Class="brand">
                <img src="@AppTheme.Logo" alt="SFKV" class="brand-logo" />
                <span class="brand-text">
                    <span class="brand-title">Swiss Bowling</span>
                    <span class="brand-subtitle">Meisterschaften &amp; Ranglisten der SFKV</span>
                </span>
            </MudLink>
            <MudSpacer />
            <nav class="d-none d-md-flex gap-1">
                @foreach (var (href, text) in Links)
                {
                    <MudButton Href="@href" Color="Color.Inherit" Class="nav-link">@text</MudButton>
                }
            </nav>
            <MudIconButton Icon="@(_darkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Color="Color.Inherit" Class="ml-2" OnClick="@(() => _darkMode = !_darkMode)" />
            <MudButton Href="/admin" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Lock" Class="ml-2 d-none d-sm-flex">Administration</MudButton>
        </MudContainer>
    </MudAppBar>
    <ActivityBar />

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary" Class="d-md-none">
        <MudNavMenu Class="pa-2">
            @foreach (var (href, text) in Links)
            {
                <MudNavLink Href="@href" Match="@(href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">@text</MudNavLink>
            }
            <MudDivider Class="my-2" />
            <MudNavLink Href="/admin" Icon="@Icons.Material.Outlined.Lock">Administration</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
        <footer class="footer">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="d-flex flex-wrap justify-space-between gap-2">
                <span>© @DateTime.Now.Year Schweizerische Freie Kegler-Vereinigung</span>
                <span>Daten: <MudLink Href="https://www.sfkv.ch" Target="_blank">sfkv.ch</MudLink> · <MudLink Href="https://www.uvweb.kegler.ch" Target="_blank">UVweb Ranglistenportal</MudLink></span>
            </MudContainer>
        </footer>
    </MudMainContent>
</MudLayout>
</div>

<div class="page-header">
    <div>
        @if (Breadcrumbs is not null)
        {
            <MudBreadcrumbs Items="Breadcrumbs" Class="pa-0 mb-1" />
        }
        <MudText Typo="Typo.h4" HtmlTag="h1" tabindex="-1">@Title</MudText>
        @if (Subtitle is not null)
        {
            <MudText Typo="Typo.body1" Class="mud-text-secondary mt-1">@Subtitle</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-header-actions">@Actions</div>
    }
</div>

@inherits LayoutComponentBase
<a class="skip-navigation" href="#page-content">Zum Inhalt springen</a>
<div class="dashboard-layout">
    <header class="dashboard-header">
        <a class="application-name" href="/">SwissBowling</a>
        <span class="workspace-title">@WorkspaceTitle</span>
        <span class="header-spacer"></span>
        <a class="header-link" href="/meisterschaften">Öffentliche Ranglisten</a>
    </header>
    <aside class="navigation-rail" aria-label="Seitennavigation">
        <details open>
            <summary>Navigation</summary>
            <nav aria-label="Hauptnavigation">
                <span class="navigation-group">Wettkampf</span>
                <NavLink class="navigation-item" href="/meisterschaften">Meisterschaften</NavLink>
                <span class="navigation-group">Verwaltung</span>
                <NavLink class="navigation-item" href="/administration" Match="NavLinkMatch.All">Übersicht</NavLink>
                <NavLink class="navigation-item" href="/administration/results">Resultaterfassung</NavLink>
                <NavLink class="navigation-item" href="/administration/setup">Stammdaten</NavLink>
                <NavLink class="navigation-item" href="/administration/approvals">Freigaben</NavLink>
            </nav>
        </details>
        <div class="rail-caption">Willisau-Sursee</div>
    </aside>
    <main id="page-content" class="dashboard-content" tabindex="-1">@Body</main>
</div>

<div class="master-data-grid">
<MudDataGrid T="Row" Items="Items" Filterable="true" QuickFilter="Matches" SortMode="SortMode.Multiple" Hover="true" Dense="true" ReadOnly="true" Class="my-4">
    <ToolBarContent><MudText Typo="Typo.h6">@Title</MudText><MudSpacer /><MudTextField T="string" @bind-Value="_search" Immediate="true" Label="Suchen" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" /></ToolBarContent>
    <Columns>
        <PropertyColumn Property="row => row.Name" Title="Bezeichnung" />
        <PropertyColumn Property="row => row.Details" Title="Details" />
    </Columns>
    <NoRecordsContent><MudText Class="pa-4">Keine passenden Einträge vorhanden.</MudText></NoRecordsContent>
    <PagerContent><MudDataGridPager T="Row" /></PagerContent>
</MudDataGrid>
</div>

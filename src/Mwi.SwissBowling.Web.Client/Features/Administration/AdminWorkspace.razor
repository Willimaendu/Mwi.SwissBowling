@inject IAdminApi Api
<ClubhouseProviders />
<div class="admin-workspace">
    <LiveUpdates @key="(_profile is not null)" Administration="@(_profile is not null)" Changed="SynchronizeAsync" />
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="my-4">@_error</MudAlert> }
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" aria-label="Arbeitsbereich wird geladen" /> }
    else if (_profile is null && _sessionKnown)
    {
        <section class="panel"><h2>Sicher anmelden</h2><p>Für die Administration ist ein freigegebenes Konto mit entsprechender Rolle erforderlich.</p><a class="button primary" href="/account/login?returnUrl=/administration">Anmelden / Registrieren</a></section>
    }
    else if (_profile is null)
    {
        <MudAlert Severity="Severity.Warning">Der Arbeitsbereich ist derzeit nicht erreichbar. Die Verbindung wird automatisch erneut geprüft.</MudAlert>
    }
    else if (!_profile.IsAdministrator)
    {
        <section class="panel"><h2>Willkommen, @_profile.DisplayName</h2>
            @if (_profile.AccountId is null) { <p>Beantragen Sie die Freigabe Ihres Kontos. Die Administration prüft Ihre Identität persönlich.</p><button class="button primary" disabled="@_busy" @onclick="RegisterAsync">Kontofreigabe beantragen</button> }
            else { <p>Ihr Konto ist registriert. Für diesen Arbeitsbereich sind Freigabe und administrative Rolle erforderlich.</p> }
            <MudAlert Severity="Severity.Info" Class="my-4">Der Freigabestatus wird automatisch aktualisiert.</MudAlert>
        </section>
    }
    else if (_setup is not null)
    {
        <nav class="workspace-tabs" aria-label="Arbeitsbereich">
            @foreach (var tab in new[] { "Übersicht", "Erfassung", "Stammdaten", "Freigaben" }) { <MudButton Variant="@(_tab == tab ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Disabled="@_editing" OnClick="() => _tab = tab">@tab</MudButton> }
        </nav>
        @if (_tab == "Übersicht")
        {
            <MudGrid Class="my-4">
                <MudItem xs="12" sm="4"><MudPaper Class="pa-5" Elevation="0"><MudText Typo="Typo.overline">Spieler</MudText><MudText Typo="Typo.h3">@_setup.Players.Length</MudText></MudPaper></MudItem>
                <MudItem xs="12" sm="4"><MudPaper Class="pa-5" Elevation="0"><MudText Typo="Typo.overline">Klubs</MudText><MudText Typo="Typo.h3">@_setup.Clubs.Length</MudText></MudPaper></MudItem>
                <MudItem xs="12" sm="4"><MudPaper Class="pa-5" Elevation="0"><MudText Typo="Typo.overline">Meisterschaften</MudText><MudText Typo="Typo.h3">@_setup.Events.Length</MudText></MudPaper></MudItem>
            </MudGrid>
            <MudDataGrid T="EventDto" Items="_setup.Events" Filterable="true" Hover="true" ReadOnly="true">
                <ToolBarContent><MudText Typo="Typo.h6">Meisterschaften im Überblick</MudText></ToolBarContent>
                <Columns>
                    <PropertyColumn Property="row => row.Name" Title="Meisterschaft" />
                    <PropertyColumn Property="row => row.StartDate" Title="Beginn" Format="dd.MM.yyyy" />
                    <TemplateColumn Title="Status"><CellTemplate>@StateName(context.Item.State)</CellTemplate></TemplateColumn>
                    <TemplateColumn Title="Aktion"><CellTemplate><MudButton Color="Color.Primary" OnClick="() => OpenEvent(context.Item.Id)">Resultate erfassen</MudButton></CellTemplate></TemplateColumn>
                </Columns>
                <NoRecordsContent><MudText Class="pa-4">Noch keine Meisterschaften. Legen Sie die Vorbereitung unter Stammdaten an.</MudText></NoRecordsContent>
                <PagerContent><MudDataGridPager T="EventDto" /></PagerContent>
            </MudDataGrid>
        }
        else if (_tab == "Stammdaten") { <SetupWorkspace Data="_setup" Changed="ReloadAsync" /> }
        else if (_tab == "Freigaben") { <ApprovalWorkspace Data="_setup" Revision="_revision" /> }
        else
        {
            <section class="panel"><label for="event-choice">Meisterschaft</label><select id="event-choice" value="@_eventId" @onchange="SelectEventAsync" disabled="@(_editing || _busy)"><option value="@Guid.Empty">Bitte auswählen</option>@foreach (var row in _setup.Events) { <option value="@row.Id">@row.Name · @StateName(row.State)</option> }</select></section>
            @if (SelectedEvent is { } selected)
            {
                <ResultEditor @key="selected.Id" Event="selected" Data="_setup" Revision="_revision" EditingChanged="EditingChangedAsync" />
                <section class="panel"><h2>Veröffentlichung</h2><p>Nur freigegebene Resultate werden öffentlich angezeigt. Alle Bearbeitungssperren müssen vor dem Abschluss freigegeben sein.</p>
                    @if (selected.State == EventState.Published)
                    {
                        <label for="correction-reason">Korrekturgrund</label><textarea id="correction-reason" @bind="_reason" maxlength="1000" rows="3"></textarea><button class="button" disabled="@(_busy || _editing || string.IsNullOrWhiteSpace(_reason))" @onclick="RequestCorrectionAsync">Wiedereröffnung beantragen</button><p class="muted">Eine andere administrative Person muss die Anfrage unter «Freigaben» genehmigen.</p>
                    }
                    else
                    {
                        <label class="check"><input type="checkbox" @bind="_confirmed" disabled="@_editing" /> Resultate geprüft: jetzt öffentlich freigeben.</label><button class="button primary" disabled="@(_busy || _editing || !_confirmed)" @onclick="PublishAsync">Abschliessen und veröffentlichen</button>
                    }
                    @if (selected.PublishedRevision > 0) { <a href="@($"/meisterschaften/{selected.Id}")" target="_blank" rel="noopener">Öffentlichen Stand ansehen</a> }
                </section>
            }
        }
    }
    @if (_message is not null) { <p class="notice" role="status">@_message</p> }
</div>
@code {
    private IdentityProfile? _profile;
    private bool _sessionKnown;
    private SetupDto? _setup;
    private bool _loading = true, _busy, _editing, _confirmed;
    private string? _error, _message;
    private string _tab = "Übersicht", _reason = "";
    private long _revision;
    private bool _reloadPending, _synchronizing;
    private Guid _eventId;
    private EventDto? SelectedEvent => _setup?.Events.SingleOrDefault(row => row.Id == _eventId);
    protected override Task OnInitializedAsync() => LoadAsync();
    private void OpenEvent(Guid id) { _eventId = id; _confirmed = false; _tab = "Erfassung"; }
    private Task ReloadAsync() => LoadAsync(showLoading: false);
    private async Task EditingChangedAsync(bool editing)
    {
        _editing = editing;
        if (!editing && _reloadPending) await SynchronizeAsync();
    }
    private async Task SynchronizeAsync()
    {
        _reloadPending = true;
        if (_editing || _busy || _synchronizing) return;
        _synchronizing = true;
        try
        {
            while (_reloadPending && !_editing && !_busy)
            {
                _reloadPending = false;
                await LoadAsync(showLoading: false);
                _revision++;
            }
        }
        finally { _synchronizing = false; }
    }
    private static string StateName(EventState state) => state switch { EventState.Published => "Veröffentlicht", EventState.Correcting => "In Korrektur", _ => "Entwurf" };
    private Task LoadAsync() => LoadAsync(showLoading: true);
    private async Task LoadAsync(bool showLoading)
    {
        if (showLoading) _loading = true;
        _error = null;
        try
        {
            _profile = await Api.GetAsync<IdentityProfile>("identity/me");
            _sessionKnown = true;
            if (_profile.IsAdministrator) _setup = await Api.GetAsync<SetupDto>("setup");
        }
        catch (ApiException exception)
        {
            if (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized) { _sessionKnown = true; _profile = null; _setup = null; }
            else _error = exception.Message;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _error = "Keine Verbindung. Bitte versuchen Sie es erneut."; }
        finally { _loading = false; }
    }
    private Task SelectEventAsync(ChangeEventArgs args) { _eventId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : Guid.Empty; _confirmed = false; _message = null; return Task.CompletedTask; }
    private Task RegisterAsync() => ExecuteAsync(async () => { await Api.PostAsync("identity/register", new { }); _message = "Ihre Anfrage wurde registriert."; await LoadAsync(); });
    private Task PublishAsync() => ExecuteAsync(async () => { await Api.PostAsync($"events/{_eventId}/finalize", new { }); _confirmed = false; _message = "Die Rangliste ist veröffentlicht."; await LoadAsync(); });
    private Task RequestCorrectionAsync() => ExecuteAsync(async () => { await Api.PostAsync($"events/{_eventId}/corrections", new CorrectionInput(_reason)); _reason = ""; _message = "Die Korrekturanfrage wartet auf eine zweite Person."; });
    private async Task ExecuteAsync(Func<Task> action)
    {
        _busy = true; _error = null; _message = null;
        try { await action(); }
        catch (ApiException exception) { _error = exception.Message; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _error = "Verbindung unterbrochen. Der Ausgang ist unklar; bitte vor erneutem Absenden den Stand aktualisieren."; }
        finally { _busy = false; if (_reloadPending) await SynchronizeAsync(); }
    }
}

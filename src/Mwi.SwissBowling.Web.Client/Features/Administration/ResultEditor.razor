@implements IAsyncDisposable
@inject IAdminApi Api
<section class="panel">
    <MudText Typo="Typo.h5" HtmlTag="h2">Resultate erfassen</MudText><p class="muted">Holz → 9er → 8er → Speichern. Tabulator wechselt zwischen den Feldern. Ungespeicherte Eingaben bleiben bei Verbindungsfehlern sichtbar.</p>
    @if (_error is not null) { <div role="alert" class="notice error">@_error</div> }
    @if (_message is not null) { <p role="status" class="notice">@_message</p> }
    <label for="player-search">Spieler suchen</label><input id="player-search" type="search" @bind="_search" @bind:event="oninput" disabled="@(_lease is not null)" />
    <label for="player-choice">Spieler der Saison</label><select id="player-choice" @bind="_playerId" disabled="@(_lease is not null || _busy)"><option value="@Guid.Empty">Bitte auswählen</option>@foreach (var player in EligiblePlayers) { <option value="@player.Id">@player.LastName @player.FirstName</option> }</select>
    @if (_lease is null)
    {
        <button class="button primary" disabled="@(_busy || _playerId == Guid.Empty || Event.State == EventState.Published)" @onclick="AcquireAsync">Bearbeitung starten</button>
    }
    else
    {
        <p class="status" role="status">@(_leaseValid ? "Bearbeitung reserviert · automatische Verlängerung aktiv" : "Sperre nicht bestätigt · Speichern gesperrt")</p>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <div class="score-inputs"><div><label for="total">Holz</label><input id="total" type="number" inputmode="numeric" min="0" @bind="_total" required disabled="@_busy" /></div><div><label for="nines">9er</label><input id="nines" type="number" inputmode="numeric" min="0" @bind="_nines" required disabled="@_busy" /></div><div><label for="eights">8er</label><input id="eights" type="number" inputmode="numeric" min="0" @bind="_eights" required disabled="@_busy" /></div></div>
            <label class="check"><input type="checkbox" @bind="_interrupted" disabled="@_busy" /> Abgebrochen (erspieltes Resultat wird gewertet)</label>
            <div class="actions"><button class="button primary" type="submit" disabled="@(_busy || !_leaseValid)">Speichern und freigeben</button><button class="button" type="button" disabled="@_busy" @onclick="ReleaseAsync">Eingaben verwerfen / freigeben</button></div>
        </form>
    }
    <button class="button" disabled="@(_busy || _lease is not null)" @onclick="RefreshAsync">Gespeicherte Resultate aktualisieren</button>
    <div class="table-scroll" role="region" aria-label="Gespeicherte Resultate" tabindex="0"><table><caption>Gespeicherte Resultate (nicht automatisch öffentlich)</caption><thead><tr><th scope="col">Name</th><th scope="col">Kategorie</th><th scope="col">Holz</th><th scope="col">9er</th><th scope="col">8er</th><th scope="col">Status</th></tr></thead><tbody>@foreach (var result in _results.OrderBy(row => row.Name)) { <tr><td>@result.Name</td><td>@result.Category</td><td>@result.Total</td><td>@result.Nines</td><td>@result.Eights</td><td>@(result.Interrupted ? "Abgebrochen" : "Erfasst")</td></tr> }</tbody></table></div>
</section>
@code {
    [Parameter, EditorRequired] public EventDto Event { get; set; } = default!;
    [Parameter, EditorRequired] public SetupDto Data { get; set; } = default!;
    [Parameter] public EventCallback<bool> EditingChanged { get; set; }
    private ResultDto[] _results = [];
    private Guid _playerId;
    private EditingLeaseSession? _session;
    private LeaseDto? _lease => _session?.Lease;
    private bool _leaseValid => _session?.IsValid == true;
    private bool _busy, _interrupted;
    private int _total, _nines, _eights;
    private long _version;
    private string _search = "";
    private string? _error, _message;
    private IEnumerable<PlayerDto> EligiblePlayers
    {
        get
        {
            var season = Data.AnnualChampionships.Single(row => row.Id == Event.AnnualChampionshipId).SeasonId;
            var ids = Data.Members.Where(row => row.SeasonId == season).Select(row => row.PlayerId).ToHashSet();
            return Data.Players.Where(row => ids.Contains(row.Id) && $"{row.LastName} {row.FirstName}".Contains(_search, StringComparison.OrdinalIgnoreCase));
        }
    }
    protected override Task OnInitializedAsync() => RefreshAsync();
    private async Task RefreshAsync()
    {
        try { _results = await Api.GetAsync<ResultDto[]>($"events/{Event.Id}/results"); }
        catch (ApiException exception) { _error = exception.Message; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _error = "Resultate konnten nicht geladen werden."; }
    }
    private async Task AcquireAsync()
    {
        _busy = true; _error = null; _message = null;
        try
        {
            _session = new EditingLeaseSession(Api, Event.Id, _playerId, TimeProvider.System)
            {
                RenewalFailed = () => InvokeAsync(() =>
                {
                    _error = "Die Bearbeitungssperre konnte nicht verlängert werden. Eingaben bleiben sichtbar. Sperre freigeben und gespeicherten Stand prüfen, bevor Sie erneut bearbeiten.";
                    StateHasChanged();
                })
            };
            await _session.AcquireAsync();
            await EditingChanged.InvokeAsync(true);
            _results = await Api.GetAsync<ResultDto[]>($"events/{Event.Id}/results");
            var current = _results.SingleOrDefault(row => row.PlayerId == _playerId);
            _total = current?.Total ?? 0; _nines = current?.Nines ?? 0; _eights = current?.Eights ?? 0;
            _interrupted = current?.Interrupted ?? false; _version = current?.Version ?? 0;
        }
        catch (ApiException exception) { _session?.Invalidate(); _error = exception.Message; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _session?.Invalidate(); _error = "Reservierung oder Laden fehlgeschlagen. Vor einer neuen Bearbeitung Sperre freigeben oder ablaufen lassen."; }
        finally { _busy = false; }
    }
    private async Task SaveAsync()
    {
        if (_lease is null || !_leaseValid) return;
        _busy = true; _error = null; _message = null;
        try
        {
            await _session!.StopRenewalAsync();
            if (!_session.IsValid) return;
            var saved = await Api.PutAsync<SavedVersion>($"events/{Event.Id}/results/{_playerId}", new ResultInput(_total, _nines, _eights, _interrupted, _version, _lease.Token));
            _version = saved.Version;
            await _session.ReleaseAsync();
            await EditingChanged.InvokeAsync(false);
            _message = "Resultat gespeichert und Bearbeitung freigegeben.";
            await RefreshAsync();
        }
        catch (ApiException exception) { _session?.Invalidate(); _error = exception.Message + " Eingaben bleiben sichtbar. Vor weiterer Bearbeitung Sperre freigeben und gespeicherten Stand prüfen."; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _session?.Invalidate(); _error = "Verbindung unterbrochen: Speicherstand unklar. Nicht blind erneut speichern. Sperre freigeben und Resultat aktualisieren; Eingaben bleiben bis dahin sichtbar."; }
        finally { _busy = false; }
    }
    private async Task ReleaseAsync()
    {
        if (_lease is null) return;
        _busy = true;
        try
        {
            await _session!.ReleaseAsync();
            await ClearLeaseAsync();
        }
        catch (ApiException exception) { _error = exception.Message; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _error = "Freigabe nicht bestätigt. Bitte erneut versuchen; die Sperre läuft serverseitig ab."; }
        finally { _session?.Invalidate(); _busy = false; }
    }
    private async Task ClearLeaseAsync() { _error = null; await EditingChanged.InvokeAsync(false); await RefreshAsync(); }
    public async ValueTask DisposeAsync()
    {
        if (_session is not null) await _session.DisposeAsync();
    }
    private sealed record SavedVersion(long Version);
}

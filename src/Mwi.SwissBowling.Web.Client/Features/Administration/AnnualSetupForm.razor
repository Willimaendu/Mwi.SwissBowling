@inherits SetupFormBase
<form @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <h3>Jahresmeisterschaft</h3>
    <label for="annual-season">Saison</label><select id="annual-season" @bind="_season"><option value="@Guid.Empty">Bitte auswählen</option>@foreach (var row in Data.Seasons) { <option value="@row.Id">@row.Year</option> }</select>
    <label for="annual-name">Name</label><input id="annual-name" @bind="_name" maxlength="160" required />
    <button class="button" disabled="@Busy">Jahresmeisterschaft anlegen</button>
</form>
@code {
    private Guid _season;
    private string _name = "";
    private Task SaveAsync() => CreateAsync("annual-championships", new AnnualChampionshipInput(_season, _name));
}

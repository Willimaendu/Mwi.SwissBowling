@inherits SetupFormBase
<form @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <h3>Saisonale Zuordnung</h3>
    <label for="member-season">Saison</label><select id="member-season" @bind="_season"><option value="@Guid.Empty">Bitte auswählen</option>@foreach (var row in Data.Seasons) { <option value="@row.Id">@row.Year</option> }</select>
    <label for="member-player">Spieler</label><select id="member-player" @bind="_player"><option value="@Guid.Empty">Bitte auswählen</option>@foreach (var row in Data.Players) { <option value="@row.Id">@row.LastName @row.FirstName</option> }</select>
    <label for="member-club">Klub</label><select id="member-club" @bind="_club"><option value="@Guid.Empty">Ohne Klub</option>@foreach (var row in Data.Clubs) { <option value="@row.Id">@row.Name</option> }</select>
    <label for="member-category">Kategorie</label><select id="member-category" @bind="_category">@foreach (var row in Enum.GetValues<PlayerCategory>()) { <option value="@row">@(row == PlayerCategory.Guest ? "Gäste" : row.ToString())</option> }</select>
    <button class="button" disabled="@Busy">Zuordnung speichern</button>
</form>
@code {
    private Guid _season, _player, _club;
    private PlayerCategory _category = PlayerCategory.Guest;
    private Task SaveAsync() => CreateAsync("members", new SeasonMemberInput(_season, _player, _club == Guid.Empty ? null : _club, _category));
}

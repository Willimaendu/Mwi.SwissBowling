@inherits SetupFormBase
<form class="setup-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <h3>Saison</h3>
    <MudNumericField T="int" Label="Jahr" Min="1" Max="9999" @bind-Value="_year" Required="true" Variant="Variant.Outlined" Disabled="Busy" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Busy || _year < 1 || _year > 9999)" Class="mt-4">Saison anlegen</MudButton>
</form>

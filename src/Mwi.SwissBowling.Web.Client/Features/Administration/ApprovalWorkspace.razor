@inject IAdminApi Api
<section class="panel"><h2>Kontofreigaben</h2><p>Identität persönlich prüfen. Eine Spielerzuordnung ist optional und darf erst nach eindeutiger Prüfung erfolgen. Rollen werden separat in Keycloak verwaltet.</p>
@if (_error is not null) { <div class="notice error" role="alert">@_error</div> }
@if (_message is not null) { <p role="status">@_message</p> }
<button class="button" disabled="@_busy" @onclick="LoadAsync">Anfragen aktualisieren</button>
@foreach (var account in _accounts)
{
    <article class="approval-row" @key="account.Id"><h3>@account.DisplayName</h3><label for="@($"link-{account.Id}")">Geprüfte Spielerzuordnung (optional)</label><select id="@($"link-{account.Id}")" @bind="_links[account.Id]"><option value="@Guid.Empty">Keine Zuordnung</option>@foreach (var player in Data.Players) { <option value="@player.Id">@player.LastName @player.FirstName · @(player.SfkvNumber ?? "Gast")</option> }</select><label class="check"><input type="checkbox" @bind="_verified[account.Id]" /> Identität und gegebenenfalls Zuordnung geprüft</label><button class="button primary" disabled="@(_busy || !_verified[account.Id])" @onclick="() => ApproveAccountAsync(account.Id)">Konto freigeben</button></article>
}
@if (_accounts.Length == 0) { <p>Keine offenen Kontofreigaben.</p> }
</section>
<section class="panel"><h2>Korrekturanfragen</h2><p>Nur eine andere administrative Person als die antragstellende Person kann genehmigen. Der veröffentlichte Stand bleibt bis zur erneuten Freigabe unverändert.</p>
@foreach (var correction in _corrections)
{
    <article class="approval-row"><h3>@correction.EventName</h3><p>@correction.Reason</p><button class="button" disabled="@_busy" @onclick="() => ApproveCorrectionAsync(correction)">Wiedereröffnung genehmigen</button></article>
}
@if (_corrections.Length == 0) { <p>Keine offenen Korrekturanfragen.</p> }
</section>
@code {
    [Parameter, EditorRequired] public SetupDto Data { get; set; } = default!;
    private PendingAccount[] _accounts = [];
    private CorrectionDto[] _corrections = [];
    private readonly Dictionary<Guid, bool> _verified = [];
    private readonly Dictionary<Guid, Guid> _links = [];
    private bool _busy;
    private string? _error, _message;
    protected override Task OnInitializedAsync() => LoadAsync();
    private Task LoadAsync() => ExecuteAsync(async () =>
    {
        _accounts = await Api.GetAsync<PendingAccount[]>("identity/pending");
        foreach (var account in _accounts) { _verified.TryAdd(account.Id, false); _links.TryAdd(account.Id, Guid.Empty); }
        _corrections = await Api.GetAsync<CorrectionDto[]>("events/corrections/pending");
    });
    private Task ApproveAccountAsync(Guid id) => ExecuteAsync(async () =>
    {
        await Api.PostAsync($"identity/{id}/approve", new ApproveAccountRequest(_verified[id], _links[id] == Guid.Empty ? null : _links[id]));
        _accounts = _accounts.Where(row => row.Id != id).ToArray(); _message = "Konto freigegeben.";
    });
    private Task ApproveCorrectionAsync(CorrectionDto correction) => ExecuteAsync(async () =>
    {
        await Api.PostAsync($"events/{correction.EventId}/corrections/{correction.Id}/approve", new { });
        _corrections = _corrections.Where(row => row.Id != correction.Id).ToArray(); _message = "Wiedereröffnung genehmigt. Bitte den Arbeitsbereich aktualisieren, bevor Sie Resultate bearbeiten.";
    });
    private async Task ExecuteAsync(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (ApiException exception) { _error = exception.Message; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _error = "Verbindung unterbrochen. Bitte vor erneutem Absenden den Stand aktualisieren."; }
        finally { _busy = false; }
    }
}

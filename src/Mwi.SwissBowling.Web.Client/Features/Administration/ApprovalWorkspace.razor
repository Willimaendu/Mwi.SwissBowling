@inject IAdminApi Api
<section class="panel"><h2>Kontofreigaben</h2><p>Identität persönlich prüfen. Eine Spielerzuordnung ist optional und darf erst nach eindeutiger Prüfung erfolgen. Rollen werden separat in Keycloak verwaltet.</p>
@if (_error is not null) { <div class="notice error" role="alert">@_error</div> }
@if (_message is not null) { <p role="status">@_message</p> }
<MudDataGrid T="PendingAccount" Items="_accounts" Filterable="true" Hover="true" ReadOnly="true" Loading="_busy">
    <Columns>
        <PropertyColumn Property="row => row.DisplayName" Title="Name" />
        <PropertyColumn Property="row => row.RegisteredAt" Title="Angefragt am" Format="dd.MM.yyyy HH:mm" />
        <TemplateColumn Title="Geprüfte Spielerzuordnung"><CellTemplate>
            <MudSelect T="Guid" @bind-Value="_links[context.Item.Id]" Label="Spieler (optional)" Variant="Variant.Outlined" Disabled="_busy">
                <MudSelectItem Value="Guid.Empty">Keine Zuordnung</MudSelectItem>
                @foreach (var player in Data.Players) { <MudSelectItem Value="player.Id">@player.LastName @player.FirstName · @(player.SfkvNumber ?? "Gast")</MudSelectItem> }
            </MudSelect>
        </CellTemplate></TemplateColumn>
        <TemplateColumn Title="Identitätsprüfung"><CellTemplate><MudCheckBox T="bool" @bind-Value="_verified[context.Item.Id]" Label="Identität und Zuordnung geprüft" Disabled="_busy" /></CellTemplate></TemplateColumn>
        <TemplateColumn Title="Aktion"><CellTemplate><MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || !_verified[context.Item.Id])" OnClick="() => ApproveAccountAsync(context.Item.Id)">Freigeben</MudButton></CellTemplate></TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText Class="pa-4">Keine offenen Kontofreigaben.</MudText></NoRecordsContent>
    <PagerContent><MudDataGridPager T="PendingAccount" /></PagerContent>
</MudDataGrid>
</section>
<section class="panel"><h2>Korrekturanfragen</h2><p>Nur eine andere administrative Person als die antragstellende Person kann genehmigen. Der veröffentlichte Stand bleibt bis zur erneuten Freigabe unverändert.</p>
<MudDataGrid T="CorrectionDto" Items="_corrections" Filterable="true" Hover="true" ReadOnly="true" Loading="_busy">
    <Columns>
        <PropertyColumn Property="row => row.EventName" Title="Meisterschaft" />
        <PropertyColumn Property="row => row.Reason" Title="Begründung" />
        <PropertyColumn Property="row => row.RequestedAt" Title="Angefragt am" Format="dd.MM.yyyy HH:mm" />
        <TemplateColumn Title="Aktion"><CellTemplate><MudButton Color="Color.Primary" Disabled="_busy" OnClick="() => ApproveCorrectionAsync(context.Item)">Wiedereröffnung genehmigen</MudButton></CellTemplate></TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText Class="pa-4">Keine offenen Korrekturanfragen.</MudText></NoRecordsContent>
    <PagerContent><MudDataGridPager T="CorrectionDto" /></PagerContent>
</MudDataGrid>
</section>
@code {
    [Parameter, EditorRequired] public SetupDto Data { get; set; } = default!;
    [Parameter] public long Revision { get; set; }
    private long _loadedRevision = -1;
    private PendingAccount[] _accounts = [];
    private CorrectionDto[] _corrections = [];
    private readonly Dictionary<Guid, bool> _verified = [];
    private readonly Dictionary<Guid, Guid> _links = [];
    private bool _busy;
    private string? _error, _message;
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedRevision == Revision || _busy) return;
        _loadedRevision = Revision;
        await LoadAsync();
    }
    private Task LoadAsync() => ExecuteAsync(async () =>
    {
        _accounts = await Api.GetAsync<PendingAccount[]>("identity/pending");
        foreach (var account in _accounts) { _verified.TryAdd(account.Id, false); _links.TryAdd(account.Id, Guid.Empty); }
        _corrections = await Api.GetAsync<CorrectionDto[]>("events/corrections/pending");
    });
    private Task ApproveAccountAsync(Guid id) => ExecuteAsync(async () =>
    {
        await Api.PostAsync($"identity/{id}/approve", new ApproveAccountRequest(_verified[id], _links[id] == Guid.Empty ? null : _links[id]));
        _accounts = _accounts.Where(row => row.Id != id).ToArray(); _message = "Konto freigegeben.";
    });
    private Task ApproveCorrectionAsync(CorrectionDto correction) => ExecuteAsync(async () =>
    {
        await Api.PostAsync($"events/{correction.EventId}/corrections/{correction.Id}/approve", new { });
        _corrections = _corrections.Where(row => row.Id != correction.Id).ToArray(); _message = "Wiedereröffnung genehmigt. Der Arbeitsbereich wird automatisch synchronisiert.";
    });
    private async Task ExecuteAsync(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (ApiException exception) { _error = exception.Message; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _error = "Verbindung unterbrochen. Bitte vor erneutem Absenden den Stand aktualisieren."; }
        finally
        {
            _busy = false;
            if (_loadedRevision != Revision) { _loadedRevision = Revision; await LoadAsync(); }
        }
    }
}

<section class="panel setup-workspace"><h2>Stammdaten und Vorbereitung</h2><p>Saison, Spieler und Zuordnungen vor dem ersten Resultat vorbereiten. Danach sind saisonale Zuordnungen gesperrt.</p>
@if (_error is not null) { <div class="notice error" role="alert">@_error</div> }
@if (_message is not null) { <p class="notice" role="status">@_message</p> }
<MudTabs Color="Color.Primary" Rounded="true" KeepPanelsAlive="true" Class="my-4">
    <MudTabPanel Text="Spieler">
        <MasterDataGrid Title="Spielerverzeichnis" Items="PlayerRows" />
        <PlayerSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Klubs">
        <MasterDataGrid Title="Klubs" Items="ClubRows" />
        <ClubSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Saisons">
        <MasterDataGrid Title="Saisons" Items="SeasonRows" />
        <SeasonSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Zuordnungen">
        <MasterDataGrid Title="Saisonale Zuordnungen" Items="MemberRows" />
        <MembershipSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Anlagen">
        <MasterDataGrid Title="Anlagen" Items="VenueRows" />
        <VenueSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Jahresmeisterschaften">
        <MasterDataGrid Title="Jahresmeisterschaften" Items="AnnualRows" />
        <AnnualSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Meisterschaften">
        <MasterDataGrid Title="Meisterschaften" Items="EventRows" />
        <EventSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
</MudTabs>
</section>

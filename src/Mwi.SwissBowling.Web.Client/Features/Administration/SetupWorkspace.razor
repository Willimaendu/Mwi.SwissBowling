<section class="panel"><h2>Stammdaten und Vorbereitung</h2><p>Saison, Spieler und Zuordnungen vor dem ersten Resultat vorbereiten. Danach sind saisonale Zuordnungen gesperrt.</p>
@if (_error is not null) { <div class="notice error" role="alert">@_error</div> }
@if (_message is not null) { <p class="notice" role="status">@_message</p> }
<MudTabs Color="Color.Primary" Rounded="true" KeepPanelsAlive="true" Class="my-4">
    <MudTabPanel Text="Spieler">
        <MasterDataGrid Title="Spielerverzeichnis" Items="PlayerRows" />
        <PlayerSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Klubs">
        <MasterDataGrid Title="Klubs" Items="ClubRows" />
        <ClubSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Saisons">
        <MasterDataGrid Title="Saisons" Items="SeasonRows" />
        <SeasonSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Zuordnungen">
        <MasterDataGrid Title="Saisonale Zuordnungen" Items="MemberRows" />
        <MembershipSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Anlagen">
        <MasterDataGrid Title="Anlagen" Items="VenueRows" />
        <VenueSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Jahresmeisterschaften">
        <MasterDataGrid Title="Jahresmeisterschaften" Items="AnnualRows" />
        <AnnualSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
    <MudTabPanel Text="Meisterschaften">
        <MasterDataGrid Title="Meisterschaften" Items="EventRows" />
        <EventSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    </MudTabPanel>
</MudTabs>
</section>
@code {
    [Parameter, EditorRequired] public SetupDto Data { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private bool _busy;
    private IEnumerable<MasterDataGrid.Row> PlayerRows => Data.Players.Select(row => new MasterDataGrid.Row($"{row.LastName} {row.FirstName}", $"{row.SfkvNumber ?? "Gast"} · {row.Email}"));
    private IEnumerable<MasterDataGrid.Row> ClubRows => Data.Clubs.Select(row => new MasterDataGrid.Row(row.Name, $"{row.Email} · {row.Phone}"));
    private IEnumerable<MasterDataGrid.Row> SeasonRows => Data.Seasons.Select(row => new MasterDataGrid.Row(row.Year.ToString(), "Saison"));
    private IEnumerable<MasterDataGrid.Row> VenueRows => Data.Venues.Select(row => new MasterDataGrid.Row(row.Name, $"{row.Address} · Bahnen {string.Join(", ", row.Lanes)}"));
    private IEnumerable<MasterDataGrid.Row> AnnualRows => Data.AnnualChampionships.Select(row => new MasterDataGrid.Row(row.Name, Data.Seasons.Single(season => season.Id == row.SeasonId).Year.ToString()));
    private IEnumerable<MasterDataGrid.Row> EventRows => Data.Events.Select(row => new MasterDataGrid.Row(row.Name, $"{row.StartDate:dd.MM.yyyy} – {row.EndDate:dd.MM.yyyy}"));
    private IEnumerable<MasterDataGrid.Row> MemberRows => Data.Members.Select(row =>
    {
        var player = Data.Players.Single(player => player.Id == row.PlayerId);
        var season = Data.Seasons.Single(season => season.Id == row.SeasonId);
        var club = Data.Clubs.SingleOrDefault(club => club.Id == row.ClubId);
        return new MasterDataGrid.Row($"{player.LastName} {player.FirstName}", $"{season.Year} · {club?.Name ?? "Ohne Klub"} · {row.Category}");
    });
    private string? _error, _message;
    private async Task ExecuteAsync(Func<Task> action)
    {
        _busy = true; _error = null; _message = null;
        try { await action(); _message = "Gespeichert."; await Changed.InvokeAsync(); }
        catch (ApiException exception) { _error = exception.Message; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _error = "Verbindung unterbrochen. Vor erneutem Absenden den gespeicherten Stand prüfen."; }
        finally { _busy = false; }
    }
}

<section class="panel"><h2>Stammdaten und Vorbereitung</h2><p>Saison, Spieler und Zuordnungen vor dem ersten Resultat vorbereiten. Danach sind saisonale Zuordnungen gesperrt.</p>
@if (_error is not null) { <div class="notice error" role="alert">@_error</div> }
@if (_message is not null) { <p class="notice" role="status">@_message</p> }
<div class="setup-grid">
    <SeasonSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    <ClubSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    <PlayerSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    <MembershipSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    <VenueSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    <AnnualSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
    <EventSetupForm Data="Data" Busy="_busy" Execute="ExecuteAsync" />
</div>
</section>
@code {
    [Parameter, EditorRequired] public SetupDto Data { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private bool _busy;
    private string? _error, _message;
    private async Task ExecuteAsync(Func<Task> action)
    {
        _busy = true; _error = null; _message = null;
        try { await action(); _message = "Gespeichert."; await Changed.InvokeAsync(); }
        catch (ApiException exception) { _error = exception.Message; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { _error = "Verbindung unterbrochen. Vor erneutem Absenden den gespeicherten Stand prüfen."; }
        finally { _busy = false; }
    }
}

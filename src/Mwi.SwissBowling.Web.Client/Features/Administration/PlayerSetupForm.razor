@inherits SetupFormBase
<form class="setup-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <h3>Spieler</h3>
    <MudSelect T="Guid" Label="Neuer oder bestehender Spieler" Value="_id" ValueChanged="ChoosePlayer" Variant="Variant.Outlined" Disabled="Busy">
        <MudSelectItem Value="Guid.Empty">Neuer Spieler</MudSelectItem>
        @foreach (var player in Data.Players) { <MudSelectItem Value="player.Id">@player.LastName @player.FirstName</MudSelectItem> }
    </MudSelect>
    <MudTextField T="string" Label="Vorname" @bind-Value="_firstName" MaxLength="100" Required="true" Variant="Variant.Outlined" Disabled="Busy" />
    <MudTextField T="string" Label="Nachname" @bind-Value="_lastName" MaxLength="100" Required="true" Variant="Variant.Outlined" Disabled="Busy" />
    <MudTextField T="string" Label="SFKV-Nummer (für Gäste optional)" @bind-Value="_sfkv" Variant="Variant.Outlined" Disabled="Busy" />
    <label for="birth-date">Geburtsdatum (optional)</label><input id="birth-date" type="date" @bind="_birthDate" />
    <MudTextField T="string" Label="E-Mail (optional)" InputType="InputType.Email" @bind-Value="_email" Variant="Variant.Outlined" Disabled="Busy" />
    <MudTextField T="string" Label="Telefon (optional)" InputType="InputType.Telephone" @bind-Value="_phone" Variant="Variant.Outlined" Disabled="Busy" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Busy || string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))" Class="mt-4">Spieler speichern</MudButton>
</form>

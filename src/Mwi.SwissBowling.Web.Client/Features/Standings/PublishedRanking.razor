@using System.Net.Http.Json
@using System.Net
@using System.Globalization
@inject NavigationManager Navigation
<ClubhouseProviders />
<LiveUpdates Changed="LoadAsync" />
@if (_error is not null) { <MudAlert Severity="Severity.Warning">@_error</MudAlert> }
@if (_notFound)
{
    <h1>Keine veröffentlichte Rangliste</h1><p>Diese Meisterschaft ist nicht vorhanden oder noch nicht freigegeben. Neue Veröffentlichungen erscheinen automatisch.</p>
}
@if (_event is not null)
{
    <header class="page-heading"><div><p class="eyebrow">Saison @_event.Season · @_event.Venue</p><h1>@_event.Name</h1><p>@_event.StartDate.ToString("dd.MM.yyyy") – @_event.EndDate.ToString("dd.MM.yyyy")</p></div></header>
    @if (_event.UnderCorrection)
    {
        <MudAlert Severity="Severity.Info" Class="my-4">In Korrektur: Sie sehen den letzten veröffentlichten Stand. Änderungen erscheinen erst nach erneuter Freigabe.</MudAlert>
    }
    <MudTextField T="string" @bind-Value="_search" Immediate="true" Label="Name oder Klub suchen" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="my-4" />
    @foreach (var category in _event.Standings.GroupBy(row => row.Category))
    {
        <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">@(category.Key == PlayerCategory.Guest ? "Gäste" : $"Kategorie {category.Key}")</MudText>
        <MudDataGrid T="RankedRow" Items="category" Filterable="true" QuickFilter="Matches" SortMode="SortMode.Multiple" Dense="true" Hover="true" ReadOnly="true">
            <Columns>
                <PropertyColumn Property="row => row.Rank" Title="Rang" />
                <PropertyColumn Property="row => row.Name" Title="Name" />
                <PropertyColumn Property="row => row.Club" Title="Klub" />
                <PropertyColumn Property="row => row.Total" Title="Holz" />
                <PropertyColumn Property="row => row.Nines" Title="9er" />
                <PropertyColumn Property="row => row.Eights" Title="8er" />
                <TemplateColumn Title="Status"><CellTemplate>@(context.Item.Interrupted ? "Abgebrochen · erspieltes Resultat" : "Erfasst")</CellTemplate></TemplateColumn>
            </Columns>
            <NoRecordsContent><MudText Class="pa-4">Keine passenden Resultate.</MudText></NoRecordsContent>
            <PagerContent><MudDataGridPager T="RankedRow" /></PagerContent>
        </MudDataGrid>
    }
    <MudText Typo="Typo.body2" Class="my-4">Veröffentlicht: @SwissTime(_event.PublishedAt) (Schweizer Zeit) · Version @_event.Revision · Rangfolge: Holz, 9er, 8er; bei Gleichheit geteilter Rang.</MudText>
}

@code {
    [Parameter, EditorRequired] public Guid EventId { get; set; }
    [Parameter] public PublicEventDto? InitialEvent { get; set; }
    [Parameter] public bool InitialUnavailable { get; set; }
    [Parameter] public bool InitialNotFound { get; set; }
    private PublicEventDto? _event;
    private string _search = "";
    private string? _error;
    private bool _notFound;
    protected override void OnInitialized()
    {
        _event = InitialEvent;
        _notFound = InitialNotFound;
        if (InitialUnavailable) _error = "Rangliste derzeit nicht erreichbar. Die Verbindung wird automatisch erneut geprüft.";
    }
    private static string SwissTime(DateTimeOffset time) => TimeZoneInfo.ConvertTime(time, TimeZoneInfo.FindSystemTimeZoneById("Europe/Zurich")).ToString("dd.MM.yyyy HH:mm", CultureInfo.GetCultureInfo("de-CH"));
    private bool Matches(RankedRow row) => $"{row.Name} {row.Club}".Contains(_search, StringComparison.CurrentCultureIgnoreCase);
    private async Task LoadAsync()
    {
        try
        {
            using var client = new HttpClient { BaseAddress = Navigation.ToAbsoluteUri("/") };
            using var response = await client.GetAsync($"public-api/events/{EventId}");
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _event = null;
                _notFound = true;
                _error = null;
                return;
            }
            response.EnsureSuccessStatusCode();
            _event = await response.Content.ReadFromJsonAsync<PublicEventDto>();
            _notFound = _event is null;
            _error = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        { _error = "Aktualisierung derzeit nicht möglich. Der letzte veröffentlichte Stand bleibt sichtbar."; }
    }
}

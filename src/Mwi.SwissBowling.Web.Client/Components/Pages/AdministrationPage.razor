<DashboardProviders />
<NavigationLock ConfirmExternalNavigation="_editing" OnBeforeInternalNavigation="ProtectEditing" />
<LiveRefresh @key="(_profile is not null)" Private="@(_profile is not null)" Changed="SynchronizeAsync" />
@if (_problem is not null) { <DashboardNotice IsError="true">@_problem</DashboardNotice> }
@if (_loading)
{
    <p role="status">Arbeitsbereich wird geladen …</p>
}
else if (_requiresLogin)
{
    <PageHeader Title="Anmelden" Description="Die Administration erfordert ein freigegebenes Konto." />
    <a class="dashboard-sign-in" href="/account/login?returnUrl=/administration">Anmelden / Registrieren</a>
}
else if (_profile is null)
{
    <DashboardNotice>Der Arbeitsbereich ist derzeit nicht erreichbar. Die Verbindung wird automatisch erneut geprüft.</DashboardNotice>
}
else if (!_profile.IsAdministrator)
{
    <PageHeader Title="Kontofreigabe" Description="Nach der Identitätsprüfung kann ein administrativer Arbeitsbereich freigegeben werden." />
    <p>Angemeldet als @_profile.DisplayName</p>
    @if (_profile.AccountId is null)
    {
        <FluentButton Appearance="ButtonAppearance.Primary" Disabled="_busy" OnClick="RegisterAsync">Freigabe beantragen</FluentButton>
    }
    else { <DashboardNotice>Ihr Konto ist registriert. Freigabe und administrative Rolle werden automatisch erneut geprüft.</DashboardNotice> }
}
else if (_setup is not null)
{
    @if (Section == "setup") { <MasterDataPage Data="_setup" Saved="SynchronizeAsync" /> }
    else if (Section == "results") { <ScoreEntryPage Data="_setup" Revision="_revision" EditingChanged="EditingChangedAsync" Saved="SynchronizeAsync" /> }
    else if (Section == "approvals") { <ApprovalPage Data="_setup" Revision="_revision" /> }
    else
    {
        <PageHeader Title="Übersicht" Description="Meisterschaften vorbereiten, Resultate erfassen und kontrolliert veröffentlichen." />
        <div class="overview-summary"><span>@_setup.Events.Length Meisterschaften</span><span>@_setup.Players.Length Spieler</span><span>@_setup.Clubs.Length Klubs</span></div>
        <div class="dashboard-surface dashboard-grid">
            <FluentDataGrid Items="@_setup.Events.AsQueryable()" Pagination="_pagination" ResizableColumns="true">
                <PropertyColumn Property="@((EventDto row) => row.Name)" Title="Meisterschaft" Sortable="true" />
                <PropertyColumn Property="@((EventDto row) => row.StartDate)" Title="Beginn" Format="dd.MM.yyyy" Sortable="true" />
                <TemplateColumn Title="Status" Context="row">@StateLabel(row.State)</TemplateColumn>
                <TemplateColumn Title="Aktionen"><a href="/administration/results">Resultate erfassen</a></TemplateColumn>
            </FluentDataGrid>
            @if (_setup.Events.Length == 0) { <div class="dashboard-empty">Noch keine Meisterschaften. Beginnen Sie mit den Stammdaten.</div> }
            <FluentPaginator State="_pagination" />
        </div>
    }
}
@if (_message is not null) { <DashboardNotice>@_message</DashboardNotice> }
